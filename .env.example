# Optional: use an installed Ollama model for podcast scripts. No API key is needed.
# OLLAMA_MODEL="qwen3-vl:4b-instruct"

# Optional: override the bundled local Piper neural TTS paths.
# Run .\install-piper.ps1 first to install the default local engine and voices.
# PIPER_EXE="C:/path/to/piper.exe"
# PIPER_VOICE_DIR="C:/path/to/voices"

# Optional: free local voice cloning. Run .\install-chatterbox.ps1 first.
# This does not require an API key, but it runs locally and can be slow without a GPU.
# CHATTERBOX_DIR="C:/path/to/chatterbox"
# CHATTERBOX_SCRIPT="C:/path/to/chatterbox_generate.py"
# CHATTERBOX_PYTHON="C:/path/to/python.exe"

# Optional: public app URL used when hosting the generated RSS feed elsewhere.
APP_URL="http://localhost:3174"

# Optional: studio-quality voice provider.
# This is required for ElevenLabs-level voice quality.
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
